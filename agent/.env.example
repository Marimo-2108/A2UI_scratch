# Copy to .env (git-ignored) and fill in. Never commit .env.
LLM_PROVIDER=gemini          # gemini | openai

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW    # LOW (fast) | MEDIUM | HIGH

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=                # run `uv run python tests/manual/list_models.py` to see what your key can use
OPENAI_REASONING_EFFORT=     # optional: low | medium | high (reasoning models). Empty = use temperature

# --- shared ---
GEMINI_TEMPERATURE=0.3       # (name is historical; used by both providers when no reasoning effort is set)
GEMINI_MAX_RETRIES=2         # validation retries
AGENT_HOST=localhost
AGENT_PORT=10010
USE_SYSTEM_TRUSTSTORE=1      # trust the OS certificate store (needed behind some corporate networks)
LLM_TIMEOUT_S=60             # per model call; a stalled model fails with a clear error instead of hanging
