{
  "name": "A2UI Scratch",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "containerEnv": {
    // Bind to all interfaces so VS Code / Docker can forward the port to the host browser.
    "AGENT_HOST": "0.0.0.0",
    // The browser (on the host) reaches the agent through the forwarded port.
    "VITE_AGENT_URL": "http://localhost:10010/",
    // The mounted workspace and uv cache can be on different filesystems.
    "UV_LINK_MODE": "copy",
    "UV_SYSTEM_CERTS": "true",
    "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/cloudflare.crt"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "oxc.oxc-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "process",
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/Backend/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
