{
  "name": "A2UI Scratch",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "containerEnv": {
    // Bind to all interfaces so VS Code / Docker can forward the port to the host browser.
    "AGENT_BIND_HOST": "0.0.0.0",
    // The browser (on the host) reaches the agent through the forwarded port.
    "VITE_AGENT_URL": "http://localhost:10010/",
    // Volumes live on a different filesystem than the cache; hardlinks would fail.
    "UV_LINK_MODE": "copy"
  },

  // Keep Linux-built deps out of the bind-mounted source so they never clash with a host
  // (e.g. Windows) .venv / node_modules.
  "mounts": [
    "source=a2ui-scratch-venv,target=${containerWorkspaceFolder}/agent/.venv,type=volume",
    "source=a2ui-scratch-node-modules,target=${containerWorkspaceFolder}/web/node_modules,type=volume"
  ],

  "forwardPorts": [10010, 5173],
  "portsAttributes": {
    "10010": { "label": "A2UI Agent (A2A)", "onAutoForward": "notify" },
    "5173": { "label": "Web (Vite)", "onAutoForward": "openBrowser" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "oxc.oxc-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/agent/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
