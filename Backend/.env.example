# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- LLM (Azure only, via LiteLLM) ---
# Passed to ADK as LiteLlm(model=model_name, **provider_args).
# model_name is "azure/<your-deployment-name>". provider_args may also set timeout (default 60),
# num_retries (default 3) and, for reasoning models, reasoning_effort (low | medium | high).
LLM={"model_name": "azure/gpt-4.1-mini", "provider_args": {"api_key": "", "api_base": "https://<resource>.openai.azure.com/", "api_version": "2024-12-01-preview"}}
# Optional generation settings. Reasoning models reject a custom temperature; leave unset for them.
GENERATE_CONTENT={"temperature": 0.3}
LLM_MAX_RETRIES=2            # validation retries

# --- server ---
AGENT_HOST=localhost
AGENT_PORT=10010
USE_SYSTEM_TRUSTSTORE=1      # trust the OS certificate store (needed behind some corporate networks)
